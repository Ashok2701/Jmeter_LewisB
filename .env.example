# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (login users). Server-side only - no NEXT_PUBLIC_ prefix.
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=change-me

# Existing table with the users: columns id, username, password
DB_USER_TABLE=public.jmeter_user
# Signs login-session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-64-random-hex-characters

# Optional
# DB_SSL=true                      # enable TLS to the database
# DB_SSL_REJECT_UNAUTHORIZED=true  # set false only for self-signed certificates
# DB_POOL_MAX=10
# AUTH_SESSION_HOURS=8
